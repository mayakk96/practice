# Copy to .env and fill locally, or run: python3 scripts/create_env.py
# These are requirements, not usable credentials. Never commit your .env.
DATABASE_PASSWORD=
APP_API_USERNAME=operator
APP_API_PASSWORD=
# Optional read-only REST/MCP account: fill both values or leave both empty.
APP_READONLY_USERNAME=
APP_READONLY_PASSWORD=
# Optional mock-risk scenarios (non-secret), default to LOW / no delay / no failures.
# MOCK_RISK_LEVEL=HIGH
# MOCK_RISK_FAILURES_BEFORE_SUCCESS=1
# MOCK_RISK_DELAY_MS=1500
# Optional OpenAI-compatible model, reachable from the application container.
# APPLICATION_KNOWLEDGE_MODE=http
# APPLICATION_KNOWLEDGE_BASE_URL=
# APPLICATION_KNOWLEDGE_MODEL=
# APPLICATION_KNOWLEDGE_API_KEY=
