# Copy to .env and enter local URL-safe generated passwords. Never commit .env.
DATABASE_PASSWORD=
APP_API_USERNAME=operator
APP_API_PASSWORD=
APP_READONLY_USERNAME=reader
APP_READONLY_PASSWORD=
# Safe, synthetic mock fault controls; normal has no fault.
MOCK_NETWORK_SCENARIO=normal
MOCK_NETWORK_FAILURES_BEFORE_SUCCESS=-1
MOCK_NETWORK_DELAY_MS=1500
# NETWORK_READ_TIMEOUT_SECONDS=1
# NETWORK_MAX_ATTEMPTS=3
# Optional HTTP model integration is disabled by default.
# KNOWLEDGE_MODE=http
# KNOWLEDGE_MODEL_URL=
# KNOWLEDGE_MODEL=
# KNOWLEDGE_API_KEY=
# Optional explicit nonlocal MCP hosts/ports, comma-separated.
# MCP_ALLOWED_HOSTS=
